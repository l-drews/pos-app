{
  "name": "pos-app",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "electron/dist/main.cjs",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && electron-builder install-app-deps",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/db/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "electron:compile": "node electron/build.mjs",
    "electron:dev": "concurrently -k -n nuxt,electron -c cyan,magenta \"nuxt dev\" \"wait-on http://localhost:3030 && pnpm electron:compile && electron electron/dist/main.cjs\"",
    "electron:build": "nuxt generate && pnpm electron:compile && electron-builder",
    "electron:build:mac": "nuxt generate && pnpm electron:compile && electron-builder --mac",
    "electron:build:win": "nuxt generate && pnpm electron:compile && electron-builder --win"
  },
  "dependencies": {
    "@nuxt/eslint": "1.15.2",
    "@orpc/client": "^1.14.0",
    "@orpc/server": "^1.14.0",
    "@orpc/vue-colada": "^1.14.0",
    "@pinia/colada": "^1.2.0",
    "@pinia/colada-nuxt": "1.0.0",
    "@pinia/nuxt": "0.11.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.2.1",
    "better-sqlite3": "^12.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dinero.js": "^2.0.2",
    "drizzle-orm": "^0.45.2",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.2",
    "reka-ui": "^2.9.6",
    "shadcn-nuxt": "2.6.2",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.32",
    "vue-currency-input": "^3.2.2",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "zod": "^4.3.6"
  },
  "packageManager": "pnpm@9.15.2+sha512.93e57b0126f0df74ce6bff29680394c0ba54ec47246b9cf321f0121d8d9bb03f750a705f24edc3c1180853afd7c2c3b94196d0a3d53d3e069d9e2793ef11f321",
  "devDependencies": {
    "@nuxt/test-utils": "^4.0.3",
    "@nuxtjs/tailwindcss": "7.0.0-beta.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@vue/test-utils": "^2.4.11",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.11.0",
    "playwright-core": "^1.61.1",
    "shadcn-vue": "^2.6.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.5"
  }
}
